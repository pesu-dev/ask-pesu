# =========================
# Node / Frontend
# =========================
node_modules/
# Repo-root build output. The migration re-anchored the frontend rules below to
# services/api/frontend/, which left a root-level frontend/ uncovered -- 3 MB of
# Next.js output was committed there before this was noticed.
/frontend/
out/

services/api/frontend/node_modules/
*.lockb

dist/
services/api/frontend/dist/

dist-ssr/
services/api/frontend/dist-ssr/

.next/
services/api/frontend/.next/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# Misc Project Files
# =========================
*.bru
bruno.json
*.csv
*.png

# These four are authored once at the repo root and vendored into the service
# tree by image builds and deploys, because a subtree split ships only
# services/<name>/ and the repo root never reaches a Space. Those copies are
# generated and must never be committed -- a committed copy would be a second
# source that silently goes stale.
services/*/conf/collection.yaml
services/*/requirements.txt
services/*/LICENSE
services/*/.env.example

# r/PESU JSONL exports for the backfill. Large, and r/PESU content rather than ours.
dump/
*.jsonl
*.json
